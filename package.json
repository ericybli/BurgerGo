{
  "name": "burgergo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run gen:icons && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "build:migrator": "esbuild scripts/migrate.ts --bundle --platform=node --target=node22 --format=esm --outfile=scripts/migrate.js --external:better-sqlite3 --tsconfig=tsconfig.json"
  },
  "dependencies": {
    "@serwist/next": "^9",
    "better-sqlite3": "^11",
    "drizzle-orm": "^0.36",
    "next": "^15",
    "next-intl": "^3",
    "node-html-parser": "^6.1.13",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^9.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9",
    "zod": "^3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "drizzle-kit": "^0.28",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^25",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}
