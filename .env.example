# BurgerGo environment (copy to .env next to docker-compose.yml; never commit .env)

# SQLite database file inside the container (on the burgergo-db volume).
DATABASE_PATH=/data/burgergo.db

# Resized photo storage root (on the burgergo-uploads volume).
UPLOADS_DIR=/data/uploads

# Browser key: Maps JS + Places Autocomplete. Restrict by HTTP referrer to your origin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server key: Place Details, Directions, reverse-geocode, Photos. Restrict by IP; never sent to client.
GOOGLE_MAPS_SERVER_KEY=

# Seeds settings.currency on first boot (ISO 4217). Default USD.
DEFAULT_CURRENCY=USD

# Seeds settings.language on first boot (en | zh). Default en.
DEFAULT_LANGUAGE=en

# Container timezone — drives "today" detection consistently on server + client. Default UTC.
TZ=UTC

# --- Auth (Better Auth + Google sign-in) -------------------------------------

# Session signing secret. REQUIRED in production (generate: openssl rand -base64 32).
# Changing it invalidates every session — set it once, before first login.
BETTER_AUTH_SECRET=

# Public origin (+ sub-path) the app is served at, e.g. https://example.com/burgergo.
# Drives the Google OAuth redirect URI. Unset in dev = http://localhost:3000.
BETTER_AUTH_URL=

# Google OAuth client (Web application type). Redirect URI must be
# <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing/ownerless trips are adopted by this email's account at boot (idempotent).
# Triple-check the spelling — a typo'd owner row needs manual SQL to fix.
BURGERGO_OWNER_EMAIL=

# Machine bypass for MCP tools and scripts (x-api-key header). Auth fails closed
# without it — set it if anything non-interactive calls the API.
BURGERGO_API_KEY=
